# Copie para .env.local (dev) — nunca commite segredos.
# Ambiente lógico: development | test | staging | production
APP_ENV=development
# URL pública da aplicação (usada em links de e-mail e validação de origem/CSRF)
APP_URL=http://localhost:3000

# PostgreSQL. Em dev, `pnpm db:dev` sobe um PostgreSQL 18 embarcado nesta porta.
# Na Vercel + Neon: DATABASE_URL = URL com pooler (aplicação) e DATABASE_URL_UNPOOLED = URL direta (migrações/seeds).
DATABASE_URL=postgres://realseg:realseg@localhost:54320/realseg
# DATABASE_URL_UNPOOLED=

# Sessão (ADR-0003)
SESSION_ABSOLUTE_HOURS=12
SESSION_IDLE_MINUTES=60

# Segredo para pseudonimizar IPs em auditoria/rate limit (gere com: openssl rand -hex 32)
IP_HASH_SECRET=troque-este-valor-em-cada-ambiente
# Defina como true somente atrás de proxy reverso confiável (usa X-Forwarded-For)
TRUST_PROXY=false

# Arquivos privados (fora de /public)
STORAGE_DIR=.data/storage
UPLOAD_MAX_MB=10

# E-mail (ADR-0008): outbox (dev/teste) | smtp
MAIL_DRIVER=outbox
MAIL_FROM="Intranet REALSEG <nao-responda@realseg.com.br>"
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASSWORD=

# debug | info | warn | error
LOG_LEVEL=info

# Homologação (build da Vercel): popula dados de demonstração uma única vez (nunca com APP_ENV=production)
# SEED_DEMO=true
# Senha das contas de demonstração em ambientes acessíveis pela internet (forte e secreta)
# DEMO_PASSWORD=
